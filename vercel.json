{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{.chainlit/**,public/**,chainlit.md,chainlit_app.py,career_service.py,roadmaps_tools.py}"
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index"
    }
  ]
}
